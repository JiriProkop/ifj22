.IFJcode22
CREATEFRAME
PUSHFRAME




#kontrola typu
DEFVAR GF@%check_type_var
DEFVAR GF@%check_type_type
DEFVAR GF@%check_type_bool
DEFVAR GF@%check_type_temp
JUMP %check_type_end
LABEL %check_type

POPS GF@%check_type_var
POPS GF@%check_type_type
POPS GF@%check_type_bool

TYPE GF@%check_type_temp GF@%check_type_var

# prisel null
JUMPIFNEQ %check_type_continue1 GF@%check_type_temp string@nil
JUMPIFEQ %check_type_error GF@%check_type_bool bool@false
RETURN
LABEL %check_type_continue1

JUMPIFNEQ %check_type_error GF@%check_type_type GF@%check_type_temp
RETURN

LABEL %check_type_error
EXIT int@7
LABEL %check_type_end
# kontrola typu konec


#priklad volani kontroly typu
DEFVAR LF@xx
MOVE LF@xx string@fasdfil
PUSHS bool@false
PUSHS string@string
PUSHS LF@xx
CALL %check_type






#pretypovavani
DEFVAR GF@%cast_var
DEFVAR GF@%cast_type
DEFVAR GF@%cast_null
DEFVAR GF@%cast_type_temp
JUMP %type_casting_end
LABEL %type_casting

POPS GF@%cast_var
POPS GF@%cast_type
POPS GF@%cast_null

TYPE GF@%cast_type_temp GF@%cast_var

# check for null
JUMPIFNEQ %cast_continue1 GF@%cast_type_temp string@nil
JUMPIFNEQ %cast_continue1_1 GF@%cast_null bool@true
PUSHS GF@%cast_var
RETURN
LABEL %cast_continue1_1
JUMPIFNEQ %cast_continue1_2 GF@%cast_type string@int
PUSHS int@0
RETURN
LABEL %cast_continue1_2
JUMPIFNEQ %cast_continue1_3 GF@%cast_type string@float
PUSHS float@0x0p+0
RETURN
LABEL %cast_continue1_3
PUSHS string@
RETURN
LABEL %cast_continue1

# type should be int
JUMPIFNEQ %cast_continue2 GF@%cast_type string@int
JUMPIFNEQ %cast_continue2_1 GF@%cast_type_temp string@int
PUSHS GF@%cast_var
RETURN
LABEL %cast_continue2_1
JUMPIFNEQ %cast_error GF@%cast_type_temp string@float
FLOAT2INT GF@%cast_var GF@%cast_var
PUSHS GF@%cast_var
RETURN
LABEL %cast_continue2

# type should be float
JUMPIFNEQ %cast_continue3 GF@%cast_type string@float
JUMPIFNEQ %cast_continue3_1 GF@%cast_type_temp string@float
PUSHS GF@%cast_var
RETURN
LABEL %cast_continue3_1
JUMPIFNEQ %cast_error GF@%cast_type_temp string@int
INT2FLOAT GF@%cast_var GF@%cast_var
PUSHS GF@%cast_var
RETURN
LABEL %cast_continue3

# type should be string
JUMPIFNEQ %cast_error GF@%cast_type GF@%cast_type_temp
PUSHS GF@%cast_var
RETURN

LABEL %cast_error
EXIT int@7
LABEL %type_casting_end
# konec pretypovani


# priklad volani pretypovani
DEFVAR LF@x
MOVE LF@x int@435

PUSHS bool@true
PUSHS string@float
PUSHS LF@x
CALL %type_casting
POPS LF@x
WRITE LF@x




#pretypovavani na bool
DEFVAR GF@%cast_bool_var
DEFVAR GF@%cast_bool_type
JUMP %cast_bool_end
LABEL %cast_bool

POPS GF@%cast_bool_var
TYPE GF@%cast_bool_type GF@%cast_bool_var

# int
JUMPIFNEQ %cast_bool_continue1 GF@%cast_bool_type string@int
JUMPIFNEQ %cast_bool_continue1_1 GF@%cast_bool_var int@0
PUSHS bool@false
RETURN
LABEL %cast_bool_continue1_1
PUSHS bool@true
RETURN
LABEL %cast_bool_continue1

# float
JUMPIFNEQ %cast_bool_continue2 GF@%cast_bool_type string@float
JUMPIFNEQ %cast_bool_continue2_1 GF@%cast_bool_var float@0x0p+0
PUSHS bool@false
RETURN
LABEL %cast_bool_continue2_1
PUSHS bool@true
RETURN
LABEL %cast_bool_continue2

# string
JUMPIFNEQ %cast_bool_continue3 GF@%cast_bool_type string@string
JUMPIFNEQ %cast_bool_continue3_1 GF@%cast_bool_var string@
PUSHS bool@false
RETURN
LABEL %cast_bool_continue3_1
PUSHS bool@true
RETURN
LABEL %cast_bool_continue3

PUSHS bool@false
RETURN
LABEL %cast_bool_end
# pretypovani na bool konec


# volani pretypovani na bool
DEFVAR LF@y
MOVE LF@y float@0x1p+0
PUSHS LF@y
CALL %cast_bool
POPS LF@y
WRITE LF@y






# definice funkce
DEFVAR LF@%funkce_arg1
# DEFVAR all the arg1
JUMP funkce_end
LABEL funkce_start
CREATEFRAME
DEFVAR TF@i
MOVE TF@i LF@%funkce_arg1
PUSHFRAME


LF@i

WRITE LF@arg1
WRITE LF@arg2
ADD LF@return LF@arg1 LF@arg2

PUSHS LF@return
POPFRAME
RETURN
LABEL funkce_end



# volani funkce
MOVE LF@%funkce_arg1 LF@sdfa
CALL funkce_start
DEFVAR LF@return
POPS LF@return
WRITE LF@return



# prirazeni do promenne
DEFVAR LF@promenna
MOVE LF@promenna int@5




# while cyklus
DEFVAR LF@x
MOVE LF@x int@0

DEFVAR LF@temp1
DEFVAR LF@temp2
DEFVAR LF@podminka

LABEL while_start
# zpracovani podminky (x <= 4)
LT LF@temp1 LF@x int@4
EQ LF@temp2 LF@x int@4
OR LF@podminka LF@temp1 LF@temp2
JUMPIFNEQ while_end LF@podminka bool@true

WRITE LF@x
ADD LF@x LF@x int@1

JUMP while_start
LABEL while_end




# if
JUMPIFNEQ else_start LF@podminka bool@true
WRITE string@pravda
JUMP else_end

LABEL else_start
WRITE string@nepravda
LABEL else_end



#konec
POPFRAME
CLEARS
EXIT int@0